# Names only. Real values go in Vercel > Settings > Environment Variables,
# and in .env.local on a developer's computer. Never commit real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
ADMIN_NOTIFY_EMAIL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Site
NEXT_PUBLIC_SITE_URL=
# true only on the live site, lets search engines list it
NEXT_PUBLIC_ALLOW_INDEXING=

# Random strings. CRON_SECRET guards the weekly job alert job; EMAIL_LINK_SECRET signs the stop alerts link.
CRON_SECRET=
EMAIL_LINK_SECRET=
